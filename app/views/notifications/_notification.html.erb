<% item = notification.item %>
<div id="<%= dom_id(notification) %>" class="notification">
  <% if notification.triggered_by %>
    <%= image_tag notification.triggered_by.avatar_url, class: "person-avatar", loading: "lazy", alt: "" %>
  <% end %>

  <div class="notification-content">
    <% if item %>
      <% link = item_path(item.repository.organization.name, item.repository.name, item.number, notification_link_params(notification)) %>
      <a class="notification-subject" href="<%= link %>"><%= notification.subject %></a>
      <%# The shared time_ago_in_words already appends "ago". %>
      <span class="notification-meta"><%= item.repository.full_name %> · <time title="<%= notification.created_at.strftime("%-d %b %Y, %H:%M") %>"><%= time_ago_in_words(notification.created_at) %></time></span>
    <% else %>
      <span class="notification-subject"><%= notification.subject %></span>
    <% end %>
  </div>

  <%= button(text: "Done", href: complete_notification_path(notification), variant: :outline, method: :post) %>
</div>
