<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Git" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Turbo 8 refresh broadcasts morph the page in place instead of
        replacing the whole body — keeps scroll position and typed-in forms. %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Local app styles (app/assets/stylesheets) + every shared stylesheet,
        auto-discovered in config/application.rb. %>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <% Array(Rails.application.config.x.shared_stylesheets).each do |sheet| %>
      <%= stylesheet_link_tag sheet, "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= turbo_stream_from :notifications %>
    <%= header(title: "Git", items: header_items) %>

    <%# Controllers set flash on GitHub API errors — without this they were
        silently dropped and every failure looked like success. %>
    <div class="flash-messages">
      <% { notice: flash[:notice], alert: flash[:alert] }.each do |kind, message| %>
        <% next if message.blank? %>
        <div class="flash flash-<%= kind %>" data-controller="flash" data-flash-autohide-value="<%= kind == :notice %>" role="alert">
          <span><%= message %></span>
          <button type="button" class="flash-dismiss" data-action="flash#dismiss" aria-label="Dismiss">&times;</button>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
