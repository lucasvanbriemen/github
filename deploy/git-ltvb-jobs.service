# Solid Queue worker for git.ltvb.nl (the GitHub client).
#
# Apache + Passenger runs the web process but NOT the Solid Queue supervisor,
# so webhook-triggered jobs (Turbo Stream broadcasts, notifications) need this
# long-running process. Install as root:
#
#   install -o root -g root -m 0644 deploy/git-ltvb-jobs.service /etc/systemd/system/git-ltvb-jobs.service
#   systemctl daemon-reload && systemctl enable --now git-ltvb-jobs
#   systemctl status git-ltvb-jobs
#
[Unit]
Description=git.ltvb.nl Solid Queue worker
After=network.target

[Service]
Type=simple
User=ltvb
Group=psacln
WorkingDirectory=/var/www/vhosts/ltvb.nl/git.ltvb.nl
Environment=HOME=/var/www/vhosts/ltvb.nl
ExecStart=/bin/bash -lc 'export RBENV_ROOT=/var/www/vhosts/ltvb.nl/.rbenv; export PATH=$RBENV_ROOT/shims:$RBENV_ROOT/bin:$PATH; export RAILS_ENV=production; exec bundle exec rails solid_queue:start'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
