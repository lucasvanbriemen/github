<%# Every changed file's diff. Locals: files, item, inline_comments.
    file-navigation shows one wrapper at a time; the id is one of diff-poll's
    swap targets and has to stay on the root element. %>
<div id="diff_files">
  <% files.each_with_index do |file, index| %>
    <div class="file-diff-wrapper" id="<%= file_diff_anchor(file[:filename]) %>" data-file-navigation-target="file" data-index="<%= index %>" <%= "hidden" unless index.zero? %>>
      <%= render "items/file_diff", file: file, item: item, inline_comments: inline_comments %>
    </div>
  <% end %>
</div>
