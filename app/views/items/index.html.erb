<% content_for :title, "#{@repository.name} · #{@repository.organization.name}" %>
<img src="<%= @organization.banner_light_url %>" loading="lazy" class="background-image" data-theme-image="true" data-theme-image-dark="<%= @organization.banner_dark_url %>" data-theme-image-light="<%= @organization.banner_light_url %>">

<div class="filter-with-item-wrapper">
  <%= render partial: "filters" %>

  <div class="item-wrapper">
    <div class="new-item-actions">
      <%= link_to "New issue", new_item_path(@organization.name, @repository.name, kind: "issue"), class: "button button-primary" %>
      <%= link_to "New PR", new_item_path(@organization.name, @repository.name, kind: "pr"), class: "button button-outline" %>
    </div>

    <% @items.each do |item| %>
      <%= render partial: "item", locals: { item: item } %>
    <% end %>

    <div class="pagination">
      <%= paginate @items %>
    </div>
  </div>
</div>
