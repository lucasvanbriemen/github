<%# Prev/next controls + counts. Driven entirely client-side by the
    file-navigation controller (buttons call it; the name/position update as you
    move between files). %>
<div class="file-navigation frosted-glass">
  <div class="file-nav-controls">
    <button type="button" class="button button-outline" data-action="file-navigation#prev" data-file-navigation-target="prev">Previous</button>
    <button type="button" class="button button-outline" data-action="file-navigation#next" data-file-navigation-target="next">Next</button>
  </div>
</div>
