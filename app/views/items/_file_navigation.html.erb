<% org = @repository.organization.name; repo = @repository.name %>
<div class="file-navigation frosted-glass">
  <div class="file-nav-info">
    <span class="file-nav-name"><%= file[:filename] %></span>
    <span class="file-nav-counts">
      <span class="additions">+<%= file[:additions] %></span>
      <span class="deletions">−<%= file[:deletions] %></span>
    </span>
  </div>
  <div class="file-nav-controls">
    <span class="file-nav-position"><%= index + 1 %> / <%= total %></span>
    <% if index.positive? %>
      <%= link_to "Previous", item_files_path(org, repo, @item.number, file: index - 1), class: "button button-outline" %>
    <% end %>
    <% if index < total - 1 %>
      <%= link_to "Next", item_files_path(org, repo, @item.number, file: index + 1), class: "button button-outline" %>
    <% end %>
  </div>
</div>
