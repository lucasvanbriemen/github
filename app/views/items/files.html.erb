<% content_for :title, "Files · #{@repository.name} · #{@repository.organization.name}" %>
<img src="<%= @organization.banner_light_url %>" loading="lazy" class="background-image" data-theme-image="true" data-theme-image-dark="<%= @organization.banner_dark_url %>" data-theme-image-light="<%= @organization.banner_light_url %>">

<%= turbo_stream_from @item %>

<%# All files render into the page; file-navigation shows one at a time, and
    diff-poll swaps the file list and the diffs when new commits are pushed
    (see items#diff / diff.turbo_stream.erb) — everything outside those regions,
    including the review panel's pending comments, stays put. %>
<div class="option-with-item-wrapper files-layout"
     data-controller="file-navigation diff-poll"
     data-diff-poll-url-value="<%= item_head_sha_path(@organization.name, @repository.name, @item.number) %>"
     data-diff-poll-refresh-url-value="<%= item_diff_path(@organization.name, @repository.name, @item.number) %>"
     data-diff-poll-head-value="<%= @head_sha %>">
  <%= render "items/diff_file_list", files: @files, additions: @total_additions, deletions: @total_deletions %>

  <div class="item-wrapper">
    <%= tabs(items: [
      { label: "Conversation", active: false, href: item_path(@organization.name, @repository.name, @item.number) },
      { label: "Files changed", active: true, href: item_files_path(@organization.name, @repository.name, @item.number) }
    ]) %>

    <%= render "items/diff_error", item: @item, diff_error: @diff_error %>

    <div class="files-options">
      <%= render "items/file_navigation", files: @files, additions: @total_additions, deletions: @total_deletions %>
      <%= render "items/review_panel", item: @item %>
    </div>

    <%= render "items/diff_files", files: @files, item: @item, inline_comments: @inline_comments %>
  </div>
</div>
